*.pyc
.DS_Store
/.idea/
/.tmp/
/dist/
__pycache__/

# 横幅生成用的点阵字体：十几 MB，跑 scripts/fetch_fonts.sh 现取，不入库
/assets-src/fonts/*
!/assets-src/fonts/README.md

# 底本全文快照：只用于本地看差异，检测靠同目录的指纹文件，不入库（每版 13MB）
/versions/db/*/lang_baseline_local.json

# 由 scripts/generate_all.sh 产出的图片：不入库，构建时重建。
# 这样仓库里不可能存在一张手改过、与生成器输出不一致的图。
/resourcepacks/ATM10汉化包/assets/atm/textures/questpics/
/config/fancymenu/assets/*.png

# 以下全部由 scripts/generate_all.sh 产出，不入库、构建时重建。
# 规则很硬：**任何脚本生成的汉化产物都不进 git**。多版本维护下这条尤其重要——
# 同一份生成器要对三个整合包版本负责，仓库里留一份手改过的产物，
# 就等于在别的版本上埋了一颗看不见的雷。
/scripts/upstream_format_en_us.json
/scripts/pb_upstream_en_us.json
/scripts/trophy_entity_names.json
/scripts/wood_planks_names.json
/kubejs/client_scripts/pb_hanhua_tooltip.js
/kubejs/server_scripts/pb_hanhua_cage_migrate.js
/resourcepacks/ATM10汉化包/assets/hanhua_trophies/
/resourcepacks/ATM10汉化包/assets/hanhua_wood_names/
